# Shared by every service, Prisma and docker compose. Copy to .env for local development.
# On AWS these values are rendered by Terraform into the instances' user-data.

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Host ports published by docker compose (change them if something local already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=3000

# PostgreSQL — Amazon RDS in production
DATABASE_URL=postgresql://eventflow:eventflow@localhost:5432/eventflow

# Redis — Amazon ElastiCache in production
REDIS_URL=redis://localhost:6379

# AWS region; LocalStack ignores it but the SDK requires one
AWS_REGION=us-east-1
# LocalStack endpoint. Leave empty on AWS so the SDK uses the real endpoints
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack accepts any credentials. On EC2 remove them: the instance profile (LabRole) is used
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 bucket for banners (public/…) and ticket PDFs (private/…)
S3_BUCKET=eventflow-assets
# Base URL of public objects, as seen by the browser (on AWS: https://<bucket>.s3.amazonaws.com)
S3_PUBLIC_URL=http://localhost:4566/eventflow-assets

# DynamoDB table that stores the CRUD audit log
AUDIT_TABLE=eventflow-audit-log
# true -> also log READ actions (single-resource reads)
AUDIT_LOG_READS=false

# SNS topic the APIs publish to, and the SQS queues the worker consumes
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:eventflow-domain-events
TICKET_JOBS_QUEUE=eventflow-ticket-jobs
IMAGE_JOBS_QUEUE=eventflow-image-jobs

# HS256 secret shared by the services to sign/verify access tokens (min. 16 chars)
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime
JWT_TTL_HOURS=168

# Comma-separated origins allowed to call the APIs directly (Vite dev server, gateway)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
