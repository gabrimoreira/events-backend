# API gateway + static frontend. ${*_SERVICE_URL} are replaced at container start
# (nginx image envsubst); nginx's own $variables are left untouched.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    # Banners arrive as data URLs inside the JSON body (2 MB image ≈ 2.7 MB).
    client_max_body_size 5m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ALB target group health check.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/auth/ {
        proxy_pass ${AUTH_SERVICE_URL};
    }

    location /api/events {
        proxy_pass ${CATALOG_SERVICE_URL};
    }

    # orders, me/tickets, tickets, admin/dashboard
    location /api/ {
        proxy_pass ${SALES_SERVICE_URL};
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: unknown paths fall back to index.html (React Router).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
