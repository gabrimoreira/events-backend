{
  "name": "eventflow-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/auth-service",
    "apps/catalog-service",
    "apps/sales-service",
    "apps/processing-worker"
  ],
  "scripts": {
    "postinstall": "npm run generate -w @eventflow/db",
    "dev": "concurrently -k -c blue,magenta,green,yellow \"npm:dev:*\"",
    "dev:auth": "npm run dev -w @eventflow/auth-service",
    "dev:catalog": "npm run dev -w @eventflow/catalog-service",
    "dev:sales": "npm run dev -w @eventflow/sales-service",
    "dev:worker": "npm run dev -w @eventflow/processing-worker",
    "build": "tsc -b && npm run build -w apps --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @eventflow/db",
    "db:migrate": "npm run migrate -w @eventflow/db",
    "db:seed": "npm run seed -w @eventflow/db",
    "db:reset": "npm run reset -w @eventflow/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
